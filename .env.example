# Copy to `.env` (cp .env.example .env) and change the values. Never commit the real .env file.
# These are placeholders, not real credentials.

# --- Django ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
NOTIFICATION_MAX_RETRIES=5

# --- Demo accounts (set DEMO_MODE=false outside demos) ---
DEMO_MODE=true
DEMO_PASSWORD=change-me-demo
SEED_ON_START=1

